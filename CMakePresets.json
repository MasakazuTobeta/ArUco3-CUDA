{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "vendor": {
    "aruco3cuda": {
      "SPDX-License-Identifier": "Apache-2.0"
    }
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ARUCO3CUDA_BUILD_TESTS": "ON",
        "ARUCO3CUDA_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "portability",
      "inherits": "base",
      "displayName": "All target architectures (sm_87, sm_110, sm_120, sm_121)",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "87;110;120;121"
      }
    },
    {
      "name": "dgx-spark",
      "inherits": "base",
      "displayName": "DGX Spark GB10 only (sm_121)",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "121"
      }
    },
    {
      "name": "rtx-blackwell",
      "inherits": "base",
      "displayName": "RTX Blackwell GB203 only (sm_120)",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "120"
      }
    },
    {
      "name": "native",
      "inherits": "base",
      "displayName": "Only the architecture of the running machine (auto-detected)",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "native"
      }
    },
    {
      "name": "jetson-orin",
      "inherits": "base",
      "displayName": "Jetson Orin only (sm_87)",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "87"
      }
    },
    {
      "name": "jetson-thor",
      "inherits": "base",
      "displayName": "Jetson AGX Thor only (sm_110)",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "110"
      }
    },
    {
      "name": "coverage",
      "inherits": "base",
      "displayName": "C0 / C1 coverage measurement; optimization disabled",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CUDA_ARCHITECTURES": "native",
        "ARUCO3CUDA_ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "sanitizer",
      "inherits": "base",
      "displayName": "Compute Sanitizer enabled; architecture of the running machine auto-detected",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CUDA_ARCHITECTURES": "native",
        "ARUCO3CUDA_ENABLE_COMPUTE_SANITIZER": "ON"
      }
    },
    {
      "name": "lint",
      "inherits": "base",
      "displayName": "Configuration with clang-tidy enabled",
      "cacheVariables": {
        "ARUCO3CUDA_ENABLE_CLANG_TIDY": "ON",
        "CMAKE_CUDA_ARCHITECTURES": "native"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "portability",
      "configurePreset": "portability"
    },
    {
      "name": "dgx-spark",
      "configurePreset": "dgx-spark"
    },
    {
      "name": "rtx-blackwell",
      "configurePreset": "rtx-blackwell"
    },
    {
      "name": "native",
      "configurePreset": "native"
    },
    {
      "name": "jetson-orin",
      "configurePreset": "jetson-orin"
    },
    {
      "name": "jetson-thor",
      "configurePreset": "jetson-thor"
    },
    {
      "name": "sanitizer",
      "configurePreset": "sanitizer"
    },
    {
      "name": "lint",
      "configurePreset": "lint"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    }
  ],
  "testPresets": [
    {
      "name": "portability",
      "configurePreset": "portability",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "dgx-spark",
      "configurePreset": "dgx-spark",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "rtx-blackwell",
      "configurePreset": "rtx-blackwell",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "native",
      "configurePreset": "native",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "jetson-orin",
      "configurePreset": "jetson-orin",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "jetson-thor",
      "configurePreset": "jetson-thor",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "sanitizer",
      "configurePreset": "sanitizer",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "lint",
      "configurePreset": "lint",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
