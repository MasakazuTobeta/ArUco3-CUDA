{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "vendor": {
    "aruco3cuda": {
      "SPDX-License-Identifier": "Apache-2.0"
    }
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ARUCO3CUDA_BUILD_TESTS": "ON",
        "ARUCO3CUDA_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "portability",
      "inherits": "base",
      "displayName": "All target architectures (sm_87, sm_110, sm_120, sm_121)",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "87;110;120;121"
      }
    },
    {
      "name": "dgx-spark",
      "inherits": "base",
      "displayName": "DGX Spark GB10 only (sm_121)",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "121"
      }
    },
    {
      "name": "rtx-blackwell",
      "inherits": "base",
      "displayName": "RTX Blackwell GB203 only (sm_120)",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "120"
      }
    },
    {
      "name": "native",
      "inherits": "base",
      "displayName": "Only the architecture of the running machine (auto-detected)",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "native"
      }
    },
    {
      "name": "jetson-orin",
      "inherits": "base",
      "displayName": "Jetson Orin only (sm_87)",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "87"
      }
    },
    {
      "name": "jetson-thor",
      "inherits": "base",
      "displayName": "Jetson AGX Thor only (sm_110)",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "110"
      }
    },
    {
      "name": "coverage",
      "inherits": "base",
      "displayName": "C0 / C1 coverage measurement; optimization disabled",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CUDA_ARCHITECTURES": "native",
        "ARUCO3CUDA_ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "sanitizer",
      "inherits": "base",
      "displayName": "Compute Sanitizer enabled; architecture of the running machine auto-detected",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CUDA_ARCHITECTURES": "native",
        "ARUCO3CUDA_ENABLE_COMPUTE_SANITIZER": "ON"
      }
    },
    {
      "name": "lint",
      "inherits": "base",
      "displayName": "Configuration with clang-tidy enabled",
      "cacheVariables": {
        "ARUCO3CUDA_ENABLE_CLANG_TIDY": "ON",
        "CMAKE_CUDA_ARCHITECTURES": "native"
      }
    },
    {
      "name": "dgx-spark-opencv-arm",
      "inherits": "dgx-spark",
      "displayName": "dgx-spark pinned OpenCV 4.14 ARM resize compatibility",
      "description": "Validated host HAL descriptor; override when the linked OpenCV build or host vector layout differs. Does not enable experimental GPU routes.",
      "cacheVariables": {
        "ARUCO3CUDA_RESIZE_PROFILE": "OPENCV_ARM_HAL",
        "ARUCO3CUDA_RESIZE_ARM_BACKEND": "SVE128",
        "ARUCO3CUDA_CAROTENE_X_FMA": "SEPARATE"
      }
    },
    {
      "name": "jetson-orin-opencv-arm",
      "inherits": "jetson-orin",
      "displayName": "jetson-orin pinned OpenCV 4.14 ARM resize compatibility",
      "description": "Validated host HAL descriptor; override when the linked OpenCV build or host vector layout differs. Does not enable experimental GPU routes.",
      "cacheVariables": {
        "ARUCO3CUDA_RESIZE_PROFILE": "OPENCV_ARM_HAL",
        "ARUCO3CUDA_RESIZE_ARM_BACKEND": "NEON",
        "ARUCO3CUDA_CAROTENE_X_FMA": "FUSED"
      }
    },
    {
      "name": "dgx-spark-steady",
      "inherits": "dgx-spark-opencv-arm",
      "displayName": "dgx-spark explicit steady-state CUDA candidate",
      "description": "Common algorithm choices with validated host resize descriptor; persistent512 is overridable for dense workloads. Runtime candidate/marker budgets remain explicit.",
      "cacheVariables": {
        "ARUCO3CPU_NATIVE": "ON",
        "ARUCO3CUDA_BUILD_CPU_EXPERIMENT": "ON",
        "ARUCO3CUDA_CONTOUR_STRATEGY": "ORDERED_CONTOURS",
        "ARUCO3CUDA_THRESHOLD_STRATEGY": "FUSED_AUTO",
        "ARUCO3CUDA_PYRAMID_STRATEGY": "DEMAND",
        "ARUCO3CUDA_OTSU_STRATEGY": "DENSITY_FIXED_POINT",
        "ARUCO3CUDA_OTSU_MAX_OCCUPIED_BINS": "96",
        "ARUCO3CUDA_CANDIDATE_GRID_STRATEGY": "PERSISTENT",
        "ARUCO3CUDA_CANDIDATE_GRID_BLOCKS": "512",
        "ARUCO3CUDA_CONTOUR_COUNT_STRATEGY": "EDGE_AGGREGATE",
        "ARUCO3CUDA_CONTOUR_RDP_STRATEGY": "WARP",
        "ARUCO3CUDA_CONTOUR_MATERIALIZE_STRATEGY": "WARP",
        "ARUCO3CUDA_CONTOUR_MATERIALIZE_COMPACTION_STRATEGY": "ELIGIBLE_EDGES",
        "ARUCO3CUDA_RESIZE_COEFFICIENT_STRATEGY": "KLEIDI_PRECOMPUTED"
      }
    },
    {
      "name": "jetson-orin-steady",
      "inherits": "jetson-orin-opencv-arm",
      "displayName": "jetson-orin explicit steady-state CUDA candidate",
      "description": "Common algorithm choices with validated host resize descriptor; persistent512 is overridable for dense workloads. Runtime candidate/marker budgets remain explicit.",
      "cacheVariables": {
        "ARUCO3CPU_NATIVE": "ON",
        "ARUCO3CUDA_BUILD_CPU_EXPERIMENT": "ON",
        "ARUCO3CUDA_CONTOUR_STRATEGY": "ORDERED_CONTOURS",
        "ARUCO3CUDA_THRESHOLD_STRATEGY": "FUSED_AUTO",
        "ARUCO3CUDA_PYRAMID_STRATEGY": "DEMAND",
        "ARUCO3CUDA_OTSU_STRATEGY": "DENSITY_FIXED_POINT",
        "ARUCO3CUDA_OTSU_MAX_OCCUPIED_BINS": "96",
        "ARUCO3CUDA_CANDIDATE_GRID_STRATEGY": "PERSISTENT",
        "ARUCO3CUDA_CANDIDATE_GRID_BLOCKS": "512",
        "ARUCO3CUDA_CONTOUR_COUNT_STRATEGY": "EDGE_AGGREGATE",
        "ARUCO3CUDA_CONTOUR_RDP_STRATEGY": "WARP",
        "ARUCO3CUDA_CONTOUR_MATERIALIZE_STRATEGY": "WARP",
        "ARUCO3CUDA_CONTOUR_MATERIALIZE_COMPACTION_STRATEGY": "ELIGIBLE_EDGES",
        "ARUCO3CUDA_RESIZE_COEFFICIENT_STRATEGY": "KLEIDI_PRECOMPUTED"
      }
    }
  ],
  "buildPresets": [
