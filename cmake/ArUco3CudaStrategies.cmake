aruco3cuda_strategy(ARUCO3CUDA_CONTOUR_RDP_STRATEGY SERIAL SERIAL WARP)
aruco3cuda_check_legacy_define(ARUCO3CUDA_EXPERIMENT_COOPERATIVE_RDP ${ARUCO3CUDA_CONTOUR_RDP_STRATEGY_VALUE})
aruco3cuda_strategy(ARUCO3CUDA_CONTOUR_MATERIALIZE_STRATEGY SERIAL SERIAL WARP)
aruco3cuda_check_legacy_define(ARUCO3CUDA_EXPERIMENT_COOPERATIVE_MATERIALIZE ${ARUCO3CUDA_CONTOUR_MATERIALIZE_STRATEGY_VALUE})
aruco3cuda_strategy(ARUCO3CUDA_CONTOUR_MATERIALIZE_COMPACTION_STRATEGY FULL_SLOTS FULL_SLOTS ELIGIBLE_EDGES)
aruco3cuda_check_legacy_define(ARUCO3CUDA_EXPERIMENT_COMPACT_MATERIALIZE_EDGES ${ARUCO3CUDA_CONTOUR_MATERIALIZE_COMPACTION_STRATEGY_VALUE})
if(ARUCO3CUDA_CONTOUR_MATERIALIZE_COMPACTION_STRATEGY STREQUAL "ELIGIBLE_EDGES" AND
   (NOT ARUCO3CUDA_CONTOUR_COUNT_STRATEGY STREQUAL "EDGE_AGGREGATE" OR
    NOT ARUCO3CUDA_CONTOUR_MATERIALIZE_STRATEGY STREQUAL "WARP"))
  message(FATAL_ERROR "ELIGIBLE_EDGES requires EDGE_AGGREGATE count and WARP materialization")
endif()

