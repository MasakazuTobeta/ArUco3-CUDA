# Explicit, reproducible algorithms. Legacy defaults remain until combined gates.
function(aruco3cuda_strategy name default_value)
  set(${name} "${default_value}" CACHE STRING "CUDA strategy: ${ARGN}")
  set_property(CACHE ${name} PROPERTY STRINGS ${ARGN})
  if(NOT "${${name}}" IN_LIST ARGN)
    message(FATAL_ERROR "${name} must be one of ${ARGN}; got '${${name}}'")
  endif()
  list(FIND ARGN "${${name}}" value)
  set(${name}_VALUE ${value} PARENT_SCOPE)
endfunction()

aruco3cuda_strategy(ARUCO3CUDA_CONTOUR_STRATEGY COMPONENT_EXTREMA COMPONENT_EXTREMA ORDERED_CONTOURS)
aruco3cuda_strategy(ARUCO3CUDA_THRESHOLD_STRATEGY SEPARABLE SEPARABLE FUSED_AUTO)
aruco3cuda_strategy(ARUCO3CUDA_PYRAMID_STRATEGY FULL FULL DEMAND)
aruco3cuda_strategy(ARUCO3CUDA_OTSU_STRATEGY REFERENCE REFERENCE FIXED_POINT DENSITY_FIXED_POINT)
aruco3cuda_strategy(ARUCO3CUDA_CANDIDATE_GRID_STRATEGY CAPACITY CAPACITY PERSISTENT)

set(ARUCO3CUDA_OTSU_MAX_OCCUPIED_BINS 96 CACHE STRING "Fixed-point Otsu density cutoff (1..256)")
set(ARUCO3CUDA_CANDIDATE_GRID_BLOCKS 128 CACHE STRING "Persistent candidate CTA limit (1..2147483647)")
foreach(name IN ITEMS ARUCO3CUDA_OTSU_MAX_OCCUPIED_BINS ARUCO3CUDA_CANDIDATE_GRID_BLOCKS)
  if(NOT "${${name}}" MATCHES "^[1-9][0-9]*$" OR ${name} GREATER 2147483647)
    message(FATAL_ERROR "${name} must be an integer in 1..2147483647")
  endif()
endforeach()
if(ARUCO3CUDA_OTSU_MAX_OCCUPIED_BINS GREATER 256)
  message(FATAL_ERROR "ARUCO3CUDA_OTSU_MAX_OCCUPIED_BINS must be in 1..256")
endif()

# Old private -D switches are accepted only when they agree with the maintained
# selection. Never let command-line ordering choose between contradictory values.
function(aruco3cuda_check_legacy_define macro expected)
  get_cmake_property(variables VARIABLES)
  foreach(variable IN LISTS variables)
    if(variable MATCHES "^CMAKE_(CXX|CUDA)_FLAGS($|_)")
      string(REGEX MATCHALL "(^|[ \t])[-/]D[ \t]*${macro}(=[^ \t]+)?" definitions "${${variable}}")
      foreach(definition IN LISTS definitions)
        if(definition MATCHES "=([^ \t]+)$")
          set(value "${CMAKE_MATCH_1}")
        else()
          set(value 1)
        endif()
        if(NOT "${value}" STREQUAL "${expected}")
          message(FATAL_ERROR "Legacy ${macro}=${value} in ${variable} conflicts with maintained strategy value ${expected}; remove the legacy define and select ARUCO3CUDA_*_STRATEGY")
        endif()
      endforeach()
    endif()
  endforeach()
endfunction()

if(DEFINED ARUCO3CUDA_EXPERIMENT_CONTOUR_CANDIDATES)
  if(ARUCO3CUDA_EXPERIMENT_CONTOUR_CANDIDATES)
    set(legacy_contour 1)
  else()
    set(legacy_contour 0)
  endif()
  if(NOT legacy_contour EQUAL ARUCO3CUDA_CONTOUR_STRATEGY_VALUE)
    message(FATAL_ERROR "ARUCO3CUDA_EXPERIMENT_CONTOUR_CANDIDATES conflicts with ARUCO3CUDA_CONTOUR_STRATEGY; remove the old cache option")
  endif()
endif()
aruco3cuda_check_legacy_define(ARUCO3CUDA_EXPERIMENT_CONTOUR_CANDIDATES ${ARUCO3CUDA_CONTOUR_STRATEGY_VALUE})
