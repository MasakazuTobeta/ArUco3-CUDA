aruco3cuda_check_legacy_define(ARUCO3CUDA_EXPERIMENT_OTSU_FIXED_POINT ${ARUCO3CUDA_OTSU_STRATEGY_VALUE})
aruco3cuda_check_legacy_define(ARUCO3CUDA_EXPERIMENT_PERSISTENT_CANDIDATES ${ARUCO3CUDA_CANDIDATE_GRID_STRATEGY_VALUE})
aruco3cuda_check_legacy_define(ARUCO3CUDA_OTSU_FIXED_POINT_MAX_OCCUPIED_BINS ${ARUCO3CUDA_OTSU_MAX_OCCUPIED_BINS})
aruco3cuda_check_legacy_define(ARUCO3CUDA_CANDIDATE_GRID_BLOCKS ${ARUCO3CUDA_CANDIDATE_GRID_BLOCKS})

aruco3cuda_strategy(ARUCO3CUDA_CONTOUR_COUNT_STRATEGY SERIAL SERIAL EDGE_AGGREGATE)
