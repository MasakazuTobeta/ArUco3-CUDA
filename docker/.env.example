# SPDX-License-Identifier: Apache-2.0
# docker/.env として複製し、実機に合わせて編集する。

# host の CUDA Toolkit の実体 directory。symlink ではなく実体を指定する。
ARUCO3_CUDA_HOST_PATH_DGX=/usr/local/cuda-13.0
ARUCO3_CUDA_HOST_PATH_JETSON=/usr/local/cuda-11.4

# Jetson の base image。host CUDA Toolkit の glibc 要求に合わせる。
# JetPack 5.x (L4T r35, CUDA 11.4) は ubuntu:20.04、
# JetPack 6.x (L4T r36, CUDA 12.6) は ubuntu:22.04 を指定する。
ARUCO3_JETSON_BASE_IMAGE=ubuntu:20.04

# container 起動時に環境検査を実行する場合は 1 を設定する。
ARUCO3_VERIFY_ON_START=0
