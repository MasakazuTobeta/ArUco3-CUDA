# SPDX-License-Identifier: Apache-2.0
# Copy this to docker/.env and edit it to match the actual machine.

# How the CUDA Toolkit is supplied. pinned pins it into the image; mounted mounts
# it from the host. To use mounted, overlay compose.mounted.yaml when starting.
ARUCO3_CUDA_MODE=pinned

# Used only in mounted mode: the real directory of the host CUDA Toolkit.
# Give the real directory, not a symlink.
ARUCO3_CUDA_HOST_PATH_DGX=/usr/local/cuda-13.0
ARUCO3_CUDA_HOST_PATH_JETSON=/usr/local/cuda-11.4
ARUCO3_CUDA_HOST_PATH_RTX=/usr/local/cuda-13.2

# Base image for RTX Blackwell in mounted mode.
# Match the glibc requirement of the host CUDA Toolkit. In pinned mode the image
# is ubuntu:24.04, which keeps the container aligned with dgx-spark.
#   mounting host CUDA from Ubuntu 22.04 -> ubuntu:22.04
ARUCO3_RTX_BASE_IMAGE_MOUNTED=ubuntu:22.04

# Base image for Jetson.
# pinned mode installs the CUDA packages from the L4T apt repository, so this is
# a plain ubuntu image matched to the Ubuntu version the JetPack is built on.
#   JetPack 5.1.2 (L4T r35.4.1, CUDA 11.4) -> ubuntu:20.04
#   JetPack 6.x   (L4T r36,     CUDA 12.6) -> ubuntu:22.04
# An image that already contains CUDA, such as nvcr.io/nvidia/l4t-cuda, still
# works: install-cuda-toolkit.sh detects it and installs nothing. It carries the
# whole Toolkit, so the image comes out several times larger.
ARUCO3_JETSON_BASE_IMAGE=ubuntu:20.04

# L4T release on the device, used as the apt suite the CUDA packages come from.
# Read it from /etc/nv_tegra_release; "R35 (release), REVISION: 4.1" is r35.4.
#   JetPack 5.1.2 -> r35.4
#   JetPack 6.x   -> the matching r36 suite
# Moving to another JetPack also means changing ARUCO3_CUDA_PACKAGES for the
# jetson-orin service in compose.yaml, because the package names carry the CUDA
# minor version, as in cuda-nvcc-11-4.
ARUCO3_JETSON_L4T_SUITE=r35.4

# Base image for Jetson in mounted mode. Match the glibc requirement of the host
# CUDA Toolkit.
#   JetPack 5.x (L4T r35, CUDA 11.4) -> ubuntu:20.04
#   JetPack 6.x (L4T r36, CUDA 12.6) -> ubuntu:22.04
ARUCO3_JETSON_BASE_IMAGE_MOUNTED=ubuntu:20.04

# Set to 1 to run the environment check when the container starts.
ARUCO3_VERIFY_ON_START=0

# GIDs of the groups that own the Tegra device nodes on Jetson.
# Check `getent group video` and `getent group debug` on the host and set them.
# video is required for CUDA to work at all; debug is used by the profiler and
# Compute Sanitizer.
ARUCO3_JETSON_VIDEO_GID=44
ARUCO3_JETSON_DEBUG_GID=995

# Sources for the Jetson-specific measurement conditions. Override them to match
# the layout on the device.
ARUCO3_JETSON_L4T_RELEASE=/etc/nv_tegra_release
ARUCO3_JETSON_NVPMODEL_STATE=/var/lib/nvpmodel
ARUCO3_JETSON_NVPMODEL_CONF=/etc/nvpmodel.conf
ARUCO3_JETSON_MODEL_FILE=/sys/firmware/devicetree/base/model

# uid and gid the container runs as. Give the host's `id -u` and `id -g` so that
# no root-owned files are created in the bind-mounted repository.
ARUCO3_UID=1000
ARUCO3_GID=1000
