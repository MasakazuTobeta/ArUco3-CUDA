# SPDX-License-Identifier: Apache-2.0
# docker/.env として複製し、実機に合わせて編集する。

# CUDA Toolkit の供給方式。pinned は image へ固定、mounted は host から mount。
# mounted を使う場合は compose.mounted.yaml を重ねて起動する。
ARUCO3_CUDA_MODE=pinned

# mounted mode でのみ使用する。host の CUDA Toolkit の実体 directory。
# symlink ではなく実体を指定する。
ARUCO3_CUDA_HOST_PATH_DGX=/usr/local/cuda-13.0
ARUCO3_CUDA_HOST_PATH_JETSON=/usr/local/cuda-11.4
ARUCO3_CUDA_HOST_PATH_RTX=/usr/local/cuda-13.2

# mounted mode での RTX Blackwell の base image。
# host CUDA Toolkit の glibc 要求に合わせる。pinned mode では ubuntu:24.04 を
# 使い、dgx-spark と container を揃える。
#   Ubuntu 22.04 の host CUDA を mount する -> ubuntu:22.04
ARUCO3_RTX_BASE_IMAGE_MOUNTED=ubuntu:22.04

# Jetson の base image。
# pinned mode: CUDA を含む image を指定する。実機の JetPack へ合わせる。
# l4t-cuda は CUDA のみを含み、l4t-jetpack より小さい。
#   JetPack 5.1.2 (L4T r35.4.1, CUDA 11.4) -> nvcr.io/nvidia/l4t-cuda:11.4.19-devel
#   JetPack 6.x   (L4T r36,     CUDA 12.6) -> nvcr.io/nvidia/l4t-cuda:12.6.11-devel
ARUCO3_JETSON_BASE_IMAGE=nvcr.io/nvidia/l4t-cuda:11.4.19-devel

# mounted mode での Jetson base image。host CUDA Toolkit の glibc 要求に合わせる。
#   JetPack 5.x (L4T r35, CUDA 11.4) -> ubuntu:20.04
#   JetPack 6.x (L4T r36, CUDA 12.6) -> ubuntu:22.04
ARUCO3_JETSON_BASE_IMAGE_MOUNTED=ubuntu:20.04

# container 起動時に環境検査を実行する場合は 1 を設定する。
ARUCO3_VERIFY_ON_START=0

# Jetson の Tegra device node が属する group の GID。
# host で `getent group video` と `getent group debug` を確認して設定する。
# video は CUDA の動作に必須、debug は profiler と Compute Sanitizer で使う。
ARUCO3_JETSON_VIDEO_GID=44
ARUCO3_JETSON_DEBUG_GID=995

# Jetson 固有の測定条件の取得元。実機の配置に合わせて上書きする。
ARUCO3_JETSON_L4T_RELEASE=/etc/nv_tegra_release
ARUCO3_JETSON_NVPMODEL_STATE=/var/lib/nvpmodel
ARUCO3_JETSON_NVPMODEL_CONF=/etc/nvpmodel.conf
ARUCO3_JETSON_MODEL_FILE=/sys/firmware/devicetree/base/model

# container を実行する uid と gid。bind mount した repository へ
# root 所有の file を作らないため、host の `id -u` と `id -g` を指定する。
ARUCO3_UID=1000
ARUCO3_GID=1000
