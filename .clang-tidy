# SPDX-License-Identifier: Apache-2.0
#
# Provisional settings. The naming conventions and the RAII policy from
# CONTRIBUTING.md are part of what is checked. clang-tidy cannot parse CUDA .cu
# files, so this applies to C++ only.
#
# Why performance-enum-size is disabled:
#   The underlying type int of Status is part of the public ABI. To keep the
#   representation stable if a C API is added later, and when values are passed
#   between host and device, fixing the type takes priority over reducing its
#   size.
#
# Why misc-const-correctness is disabled:
#   cv::Mat and GpuMat are handle types; making the handle const still leaves the
#   pixels it points at mutable. Adding const would read as if the data were
#   immutable, so this check's advice is actively misleading here.
Checks: >
  -*,
  bugprone-*,
  cppcoreguidelines-owning-memory,
  cppcoreguidelines-no-malloc,
  cppcoreguidelines-pro-type-cstyle-cast,
  misc-*,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  performance-*,
  readability-identifier-naming,
  -misc-non-private-member-variables-in-classes,
  -bugprone-easily-swappable-parameters,
  -performance-enum-size,
  -misc-const-correctness
WarningsAsErrors: ''
HeaderFilterRegex: '.*/(include|src)/aruco3cuda/.*'
CheckOptions:
  # The CUDA and OpenCV types come from internal headers that should not be
  # included directly. cuda_runtime_api.h and opencv2/*.hpp are treated as the
  # entry points.
  - key: misc-include-cleaner.IgnoreHeaders
    value: '.*cuda_runtime.*;.*driver_types.*;.*vector_types.*;.*crt/.*;.*cuda_device_runtime_api.*;.*opencv2/.*'
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  # Apply "constants are kPascalCase" from CONTRIBUTING.md to every place a
  # constant can appear.
  - key: readability-identifier-naming.GlobalConstantPrefix
    value: k
  - key: readability-identifier-naming.GlobalConstantCase
    value: CamelCase
  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: k
  - key: readability-identifier-naming.ConstexprVariableCase
    value: CamelCase
  # LocalConstant covers local variables declared const in general. In
  # CONTRIBUTING.md those count as local variables and use snake_case.
  # kPascalCase applies to compile-time constants (ConstexprVariable and
  # static/global/class constants).
  - key: readability-identifier-naming.LocalConstantCase
    value: lower_case
  - key: readability-identifier-naming.StaticConstantPrefix
    value: k
  - key: readability-identifier-naming.StaticConstantCase
    value: CamelCase
  - key: readability-identifier-naming.ClassConstantPrefix
    value: k
  - key: readability-identifier-naming.ClassConstantCase
    value: CamelCase
