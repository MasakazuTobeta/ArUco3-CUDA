# Build artifacts
/build/
/out/
**/build/
compile_commands.json

# Environment-specific container settings
docker/.env

# Measurement results and bulk data. Only the manifest is committed.
/data/**
!/data/manifest/
!/data/manifest/**
/results/
*.mp4
*.avi

# New CPU experiment output stays local; keep reports and reproduction sources.
# Removing previously tracked GPU measurement logs is a separate PR (issue #23).
/docs/measurements/*-cpu-*/**
!/docs/measurements/*-cpu-*/**/
!/docs/measurements/*-cpu-*/**/*.md
!/docs/measurements/*-cpu-*/**/*.py
!/docs/measurements/*-cpu-*/**/*.sh
!/docs/measurements/*-cpu-*/**/*.cpp
!/docs/measurements/*-cpu-*/**/*.hpp
!/docs/measurements/*-cpu-*/**/*.patch
!/docs/measurements/*-cpu-*/**/Dockerfile
!/docs/measurements/*-cpu-*/**/qa-source-hashes.json

# Downloaded packages. clang_format-*.whl was committed by accident in
# e55bf2f; the toolchain uses clang-format-18 from the container, never a
# wheel from here.
*.whl

# Python bytecode. Two of these were committed by accident alongside the
# tools/*.py scripts.
__pycache__/
*.pyc

# editor
.vscode/
.idea/
*.swp
