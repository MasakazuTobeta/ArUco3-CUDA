# Build artifacts
/build/
/out/
**/build/
compile_commands.json

# Local experiment notes, measurement records and build snapshots
/.runtime/

# Environment-specific container settings
docker/.env

# Measurement results and bulk data. Only the manifest is committed.
/data/**
!/data/manifest/
!/data/manifest/**
/results/
*.mp4
*.avi

# CPU, GPU and Hybrid output stays local; keep reports and reproduction sources.
/docs/measurements/**
!/docs/measurements/**/
!/docs/measurements/**/*.md
!/docs/measurements/**/*.py
!/docs/measurements/**/*.sh
!/docs/measurements/**/*.cpp
!/docs/measurements/**/*.hpp
!/docs/measurements/**/*.patch
!/docs/measurements/**/Dockerfile
# Fixed input to the historical audit, not generated result/checksum output.
!/docs/measurements/2026-11-17-cpu-multihost/qa-source-hashes.json

# Downloaded packages. clang_format-*.whl was committed by accident in
# e55bf2f; the toolchain uses clang-format-18 from the container, never a
# wheel from here.
*.whl

# Python bytecode. Two of these were committed by accident alongside the
# tools/*.py scripts.
__pycache__/
*.pyc

# editor
.vscode/
.idea/
*.swp
