# SPDX-License-Identifier: Apache-2.0
#
# Provisional settings. The open question in ADR-0002 - whether the clang-format
# style should follow OpenCV or be our own - is still undecided, and for now the
# settings stay close to OpenCV in anticipation of contributing back to it. Once
# decided, the outcome is recorded in the ADR.
---
Language: Cpp
BasedOnStyle: Google
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100
AccessModifierOffset: -4
ConstructorInitializerIndentWidth: 4
ContinuationIndentWidth: 8
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false
BreakBeforeBraces: Attach
DerivePointerAlignment: false
PointerAlignment: Left
IncludeBlocks: Preserve
SortIncludes: CaseSensitive
SpaceAfterCStyleCast: false
Standard: c++17
